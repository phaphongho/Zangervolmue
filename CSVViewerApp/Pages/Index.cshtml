@page
@model IndexModel
@{
    ViewData["Title"] = "CSV Viewer - Filter & Search";
}

<div class="container mt-5">
    <h1>📊 CSV Viewer - Filter & Search</h1>
    
    <div class="card mb-4">
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4">
                    <form method="post" enctype="multipart/form-data">
                        <div class="input-group">
                            <input type="file" class="form-control" name="csvFile" accept=".csv" required />
                            <button type="submit" class="btn btn-primary" name="uploadFile">📁 Open CSV File</button>
                        </div>
                    </form>
                </div>
            </div>

            @if (Model.DataTable != null && Model.DataTable.Rows.Count > 0)
            {
                <hr />
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label">🔍 Filter Column:</label>
                        <select class="form-select" id="filterColumn" onchange="applyFilter()">
                            @foreach (System.Data.DataColumn column in Model.DataTable.Columns)
                            {
                                <option value="@column.ColumnName">@column.ColumnName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">🔎 Search:</label>
                        <input type="text" class="form-control" id="searchBox" placeholder="Search..." onkeyup="applyFilter()" />
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                @foreach (System.Data.DataColumn column in Model.DataTable.Columns)
                                {
                                    <th>@column.ColumnName</th>
                                }
                            </tr>
                        </thead>
                        <tbody id="tableBody">
                            @foreach (System.Data.DataRow row in Model.DataTable.Rows)
                            {
                                <tr class="data-row">
                                    @foreach (var cell in row.ItemArray)
                                    {
                                        <td>@cell</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="text-muted">Total rows: <strong>@Model.DataTable.Rows.Count</strong></p>
            }
            else if (Model.ErrorMessage != null)
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
    }
    h1 {
        color: #2c3e50;
        margin-bottom: 30px;
    }
    .table {
        margin-top: 20px;
    }
</style>

<script>
    function applyFilter() {
        const filterColumn = document.getElementById('filterColumn').value;
        const searchValue = document.getElementById('searchBox').value.toLowerCase();
        const rows = document.querySelectorAll('.data-row');

        rows.forEach(row => {
            const columnIndex = Array.from(row.parentNode.parentNode.querySelectorAll('th'))
                .findIndex(th => th.textContent === filterColumn);
            
            const cellValue = row.cells[columnIndex]?.textContent.toLowerCase() || '';
            
            if (searchValue === '' || cellValue.includes(searchValue)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }
</script>
